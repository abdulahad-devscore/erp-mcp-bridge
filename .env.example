# Copy to .env. Every value has a working default for local demos.

# Pull images through a mirror if Docker Hub rate-limits you
# REGISTRY=mirror.gcr.io

ODOO_DB=tembusu
ODOO_ADMIN_PASSWORD=admin
ODOO_DB_PASSWORD=odoo
BRIDGE_DB_PASSWORD=bridge

# Must be at least 32 characters. Tokens signed with the default are for demos only.
JWT_SECRET=change-me-in-production-please-32b
SESSION_SECRET=change-me-session-secret

# The URL clients use to reach the bridge; it is the token issuer and audience.
BRIDGE_PUBLIC_URL=http://localhost:8000

# Pin "today" so overdue days and eval answers don't drift (matches the seed data)
BUSINESS_DATE=2026-10-27

# Demo client secrets default to "<client-id>-demo-secret". Override any of them:
# BRIDGE_SECRET_OPS_COPILOT=...
# BRIDGE_SECRET_APPROVER_OPS=...

# Rate limits per OAuth client
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_WRITES_PER_MINUTE=20
